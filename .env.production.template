# ═══════════════════════════════════════════════════════════════
# قالب متغيرات بيئة الإنتاج — ERP System
# ═══════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env.production واملأ القيم الحقيقية.
# لا تضع القيم الحقيقية بهذا الملف نفسه ولا تُدرجه بـgit — أضفه لـ.gitignore.
#
# كل متغير هنا مبنيّ على استخدام فعلي بالكود (تحقّقنا عبر grep قبل
# كتابة هذا القالب)، وليس تخميناً من .env.example القديم بالمشروع —
# .env.example يحتوي أسماء next-auth v4 القديمة (NEXTAUTH_SECRET/
# NEXTAUTH_URL) وهذه غير صحيحة لهذا المشروع (يستخدم next-auth@5.0.0-beta
# الذي يقرأ AUTH_SECRET/AUTH_URL ضمنياً — تحقّقنا من هذا بقراءة src/auth.ts
# وتوثيق next-auth v5 نفسه). استخدم أسماء هذا القالب، لا .env.example.
#
# تحقق من اكتمال هذا الملف فعلياً قبل النشر عبر:
#   npm run check:env                    (فحص أساسي)
#   ./scripts/pre-deploy-check.sh .env.production   (فحص شامل: env + build + tests + migration 016)
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
# قاعدة البيانات — إلزامي (حاجب — بدونه لا يعمل أي شيء)
# ───────────────────────────────────────────────────────────────
# اتصال PostgreSQL الكامل. sslmode=require إلزامي عملياً لأي مزوّد
# إنتاج حقيقي (Render / Neon / Supabase / RDS...) — لا تحذفه.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"


# ───────────────────────────────────────────────────────────────
# المصادقة (NextAuth v5) — إلزامي (حاجب)
# ───────────────────────────────────────────────────────────────
# سرّ توقيع الجلسات — 32 حرفاً على الأقل. وَلِّده بـ:
#   openssl rand -base64 32
# **لا تُعِد استخدام أي قيمة تطوير/تجريبية هنا.** تسريب هذه القيمة يعني
# إمكانية تزوير جلسات مصادقة كاملة لأي مستخدم.
AUTH_SECRET=""

# رابط التطبيق الحقيقي الذي يعمل عليه الإنتاج — بدون شرطة مائلة بالنهاية.
# next-auth v5 يحتاجه لبناء روابط الـcallback الصحيحة.
AUTH_URL="https://yourdomain.com"

# إلزامي فعلياً لو التطبيق خلف proxy عكسي (Render/Railway/أي منصة PaaS
# تضع التطبيق خلف load balancer) — next-auth v5 يرفض الطلبات بدونه في
# هذه الحالة تحديداً كإجراء أمني افتراضي ضد Host header spoofing.
AUTH_TRUST_HOST="true"


# ───────────────────────────────────────────────────────────────
# البريد الإلكتروني — إلزامي عملياً (اختر مزوّداً واحداً: Resend أو SMTP)
# ───────────────────────────────────────────────────────────────
# بدون أحد هذين مكتملاً: تنبيهات SECURITY_ALERT_EMAIL (كسر سلسلة
# التدقيق)، تنبيهات تسوية المخزون (reconcileStockLedger)، وأي بريد
# تطبيقي آخر لن تُرسَل إطلاقاً — لا خطأ ظاهر، فقط صمت.

# ── الخيار 1: Resend (موصى به للإنتاج) ──
RESEND_API_KEY=""
EMAIL_FROM="ERP System <noreply@yourdomain.com>"

# ── الخيار 2: SMTP (بديل — فعِّل هذه بدل Resend لو لم تستخدمه) ──
# SMTP_HOST="smtp.yourprovider.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="ERP System <noreply@yourdomain.com>"


# ───────────────────────────────────────────────────────────────
# التنبيهات الأمنية والتشغيلية — موصى به بقوة (غير حاجب لكن مهم جداً)
# ───────────────────────────────────────────────────────────────
# البريد الذي يصله تنبيه فوري لو انكسرت سلسلة سجل التدقيق
# (verify-audit-integrity.ts) أو اكتُشف انحراف مخزون
# (reconcile-stock-ledger.ts). يجب أن يصل فعلياً لشخص يراقبه —
# ليس صندوق بريد مهمَل. اختبر وصول بريد حقيقي إليه قبل الاعتماد عليه.
SECURITY_ALERT_EMAIL=""


# ───────────────────────────────────────────────────────────────
# التطبيق — موصى به
# ───────────────────────────────────────────────────────────────
NODE_ENV="production"

# رابط التطبيق العام — يُستخدَم لبناء روابط مطلَقة (مثال: روابط داخل
# رسائل البريد الإلكتروني). يجب أن يطابق AUTH_URL أعلاه.
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="نظام إدارة الموارد"


# ───────────────────────────────────────────────────────────────
# التخزين — اختياري (إلزامي فقط لو رفع المرفقات/الوثائق مفعَّل)
# ───────────────────────────────────────────────────────────────
# Cloudflare R2 / AWS S3 / MinIO — أي خدمة متوافقة مع S3 API.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="erp-documents"
STORAGE_REGION="auto"

# رابط عام منفصل لو الـbucket يُقدَّم عبر CDN/دومين مختلف عن STORAGE_ENDPOINT
# (مثال: Cloudflare R2 مع دومين مخصَّص). اتركه فارغاً ليستخدم الكود
# STORAGE_ENDPOINT تلقائياً كبديل (راجع src/lib/storage/upload.ts).
# STORAGE_PUBLIC_URL=""


# ───────────────────────────────────────────────────────────────
# تهيئة أولية للإنتاج (npm run db:seed:prod) — حسّاس، اقرأ التحذير
# ───────────────────────────────────────────────────────────────
# ⚠️ تحذير أمني حقيقي: src/db/seed-production.ts يستخدم كلمة مرور
# افتراضية معروفة بالكود المصدري (Admin@1234) لو هذا المتغير غير
# معرَّف. **عرِّفه دائماً قبل تشغيل db:seed:prod على أي بيئة إنتاج
# حقيقية** — وإلا سيُنشأ حساب admin بكلمة مرور معروفة للعامة على
# GitHub لأي شخص قرأ الكود المصدري.
SEED_ADMIN_EMAIL="admin@yourorg.com"
SEED_ADMIN_PASSWORD=""


# ───────────────────────────────────────────────────────────────
# المراقبة — اختياري بالكامل (اتركها فارغة/معلَّقة لتعطيلها بأمان)
# ───────────────────────────────────────────────────────────────
# Sentry (مراقبة أخطاء الإنتاج)
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# PostHog (تحليلات استخدام — اختياري)
# NEXT_PUBLIC_POSTHOG_KEY=""
