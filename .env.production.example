# ═══════════════════════════════════════════════════════════════
# ERP System — متغيرات بيئة الإنتاج
# لا تنسخ هذا الملف كما هو! انسخ كل قيمة يدوياً للوحة تحكم الاستضافة
# (Vercel / Render / إلخ) — لا تضع القيم الحقيقية بأي ملف داخل الـ repo.
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# 🔴 حرج — التطبيق لن يعمل بدونها
# ─────────────────────────────────────────────────────────────────

# قاعدة البيانات (Neon / Render Postgres / Supabase / أي PostgreSQL مُدار)
# لازم يحتوي sslmode=require للإنتاج
DATABASE_URL="postgresql://user:password@host:5432/erp_prod?sslmode=require"

# مفتاح تشفير الجلسات — ولّد قيمة جديدة، لا تعيد استخدام قيمة التطوير:
#   openssl rand -base64 32
NEXTAUTH_SECRET="__GENERATE_NEW_VALUE__"

# الدومين الحقيقي للتطبيق بعد النشر (بدون شرطة مائلة بالنهاية)
NEXTAUTH_URL="https://erp.yourdomain.com"

NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://erp.yourdomain.com"
NEXT_PUBLIC_APP_NAME="نظام إدارة الموارد"
NEXT_PUBLIC_ORG_NAME="اسم مؤسستك"

# ─────────────────────────────────────────────────────────────────
# 🟡 بذر بيانات الإنتاج — تُستخدم مرة واحدة فقط عند تشغيل db:seed:prod
# بعدها احذفها من لوحة التحكم أو غيّرها، ولا تُبقيها بمتغيرات البيئة الدائمة
# ─────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="owner@yourdomain.com"
SEED_ADMIN_PASSWORD="__STRONG_UNIQUE_PASSWORD__"

# ─────────────────────────────────────────────────────────────────
# 🟡 البريد الإلكتروني — بدونه الإشعارات (موافقات، تنبيهات ميزانية) لن تُرسل
# اختر واحداً فقط: Resend (موصى به) أو SMTP
# ─────────────────────────────────────────────────────────────────

# الخيار 1: Resend — https://resend.com (مجاني حتى 3000 إيميل/شهر)
RESEND_API_KEY=""
EMAIL_FROM="ERP System <noreply@yourdomain.com>"

# الخيار 2: SMTP (فعّل هذه واترك RESEND_API_KEY فاضي)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="yourmail@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="ERP System <yourmail@gmail.com>"

# ─────────────────────────────────────────────────────────────────
# 🟡 تنبيه أمني مباشر — البريد الذي يصله تنبيه فوري لو انكسرت سلسلة
# سجل التدقيق (verifyAuditChain عبر مهمة audit:verify الدورية). يجب أن
# يكون صندوق بريد يُراقَب فعلياً (قناة أوبس)، وليس بريد مستخدم عادي
# بالنظام — راجع src/core/audit/scheduled-check.ts لسبب هذا الفصل.
# ─────────────────────────────────────────────────────────────────
SECURITY_ALERT_EMAIL="security-ops@yourdomain.com"

# ─────────────────────────────────────────────────────────────────
# 🟢 التخزين — اختياري. بدونه رفع المرفقات (فواتير، عقود) لن يعمل
# Cloudflare R2 (موصى به، متوافق S3، بدون رسوم مرور بيانات) أو AWS S3 / MinIO
# ─────────────────────────────────────────────────────────────────
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="erp-documents"
STORAGE_REGION="auto"
# الرابط العام لعرض الملفات (لو مختلف عن STORAGE_ENDPOINT، مثل نطاق R2 مخصص)
STORAGE_PUBLIC_URL=""

# ─────────────────────────────────────────────────────────────────
# 🟢 المراقبة — اختياري لكن موصى به بشدة للإنتاج
# ─────────────────────────────────────────────────────────────────
# SENTRY_DSN=""
# NEXT_PUBLIC_POSTHOG_KEY=""

# ═══════════════════════════════════════════════════════════════
# ✅ قائمة تحقق قبل أول نشر:
# 1. غيّرت NEXTAUTH_SECRET لقيمة جديدة (مو نفس قيمة .env.local)؟
# 2. DATABASE_URL يشير لقاعدة إنتاج حقيقية (مو localhost)؟
# 3. جربت SEED_ADMIN_PASSWORD قوية وفريدة؟
# 4. بعد أول db:seed:prod ناجح، سجّلت دخول وغيّرت كلمة المرور من التطبيق نفسه؟
# 5. جرّبت GET /api/health ورجعت status:"ok"؟
# 6. شغّلت npm run check:migration-016 ضد قاعدة الإنتاج قبل أي migration
#    جديدة، وصفر صفوف مخالفة (أو طبّقت خطة NOT VALID/VALIDATE)؟
# 7. SECURITY_ALERT_EMAIL معرَّف ويصل فعلياً (جرّب npm run audit:verify يدوياً)؟
# راجع DEPLOYMENT_GUIDE.md لتفاصيل كل خطوة وترتيبها الكامل.
# ═══════════════════════════════════════════════════════════════
