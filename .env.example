# ═══════════════════════════════════════════════════════════════
# ERP System — متغيرات البيئة الكاملة
# انسخ هذا الملف إلى .env.local وعدّل القيم
# npx openssl rand -base64 32  ← لتوليد NEXTAUTH_SECRET
# ═══════════════════════════════════════════════════════════════

# ── قاعدة البيانات ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/erp_db"
# للإنتاج (Render / Neon / Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/erp_prod?sslmode=require"

# ── المصادقة (NextAuth v5) ──────────────────────────────────────
NEXTAUTH_SECRET="your-secret-min-32-chars-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# للإنتاج:
# NEXTAUTH_URL="https://yourdomain.com"

# ── البريد الإلكتروني (اختر واحداً) ──────────────────────────────
# الخيار 1: Resend (الأفضل للإنتاج - مجاني حتى 3000/شهر)
RESEND_API_KEY=""
EMAIL_FROM="ERP System <noreply@yourdomain.com>"

# الخيار 2: SMTP (Gmail / Outlook / أي خادم)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="yourmail@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="ERP System <yourmail@gmail.com>"

# ── التطبيق ─────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="نظام إدارة الموارد"
NEXT_PUBLIC_ORG_NAME="منظمتي"

# ── التخزين (اختياري — للمرفقات والوثائق) ──────────────────────
# Cloudflare R2 / AWS S3 / MinIO
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="erp-documents"
STORAGE_REGION="auto"

# ── المراقبة (اختياري) ──────────────────────────────────────────
# Sentry (اختياري — مراقبة أخطاء الإنتاج. اترك فارغاً لتعطيله بأمان)
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# NEXT_PUBLIC_POSTHOG_KEY=""
