# ═══════════════════════════════════════════════════════════════
# Dockerfile — ERP System v39 (Render Docker Runtime)
# ═══════════════════════════════════════════════════════════════
# يُستخدم هذا الملف لأن خدمة Render الحالية من نوع Docker Runtime
# (لا يمكن تغيير Runtime بعد إنشاء الخدمة).
# المراحل:
#   1. تثبيت Node + الحزم
#   2. بناء Next.js
#   3. عند بدء الحاوية: تشغيل Migrations 001→016 → Seed الإنتاج → npm start
# ═══════════════════════════════════════════════════════════════

FROM node:20-alpine

# قم بتثبيت libc6-compat لـ Alpine (مطلوب لبعض الحزم الأصلية مثل bcrypt)
RUN apk add --no-cache libc6-compat openssl

# تعطيل قياس استخدم Next.js (اختياري)
ENV NEXT_TELEMETRY_DISABLED 1
ENV NODE_ENV production

WORKDIR /app

# ═══════════════════════════════════════════════════════════════
# الخطوة 1: نسخ ملفات التبعيات وتثبيتها
# ═══════════════════════════════════════════════════════════════
COPY package.json package-lock.json* ./

# تثبيت جميع الحزم (devDeps مطلوبة لأن tsx و bcryptjs فيها)
# استخدم --legacy-peer-deps لتجنب مشاكل توافق الحزم
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# ═══════════════════════════════════════════════════════════════
# الخطوة 2: نسخ مصدر المشروع وبناء التطبيق
# ═══════════════════════════════════════════════════════════════
COPY . .

# تنفيذ عملية البناء
RUN npm run build

# ═══════════════════════════════════════════════════════════════
# الخطوة 3: سكربت البدء (تشغيل Migrations + Seed ثم بدء التطبيق)
# ═══════════════════════════════════════════════════════════════
# استخدام start.sh مدعوم بـ CJS fallback للاستقرار
RUN chmod +x start.sh

CMD ["./start.sh"]

# المنفذ الافتراضي لـ Next.js
EXPOSE 3000
